# ANA Mileage Club credentials
ANA_USERNAME=your_ana_mileage_club_number
ANA_PASSWORD=your_password

# Search config (defaults shown)
# DEPARTURE_CODE=TPE
# ARRIVAL_CODE=SFO
# SEARCH_DATES=2025-04-05,2025-04-06

# Hide bot Chrome windows by minimizing them over CDP right after launch.
#   off       - leave windows where Chrome puts them (default)
#   keepalive - only the 25-min keep-alive browser (low blast radius; try this first)
#   all       - keep-alive + search sessions
# Minimized windows are not composited, so the GPU stays idle while the bot runs.
# BOT_MINIMIZE_WINDOWS=keepalive

# Chrome profile (to reuse your existing browser session)
# CHROME_PROFILE_DIR=C:\Users\you\AppData\Local\Google\Chrome\User Data
# CHROME_PROFILE=Default

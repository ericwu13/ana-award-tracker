# ANA Mileage Club credentials
ANA_USERNAME=your_ana_mileage_club_number
ANA_PASSWORD=your_password

# Search config (defaults shown)
# DEPARTURE_CODE=TPE
# ARRIVAL_CODE=SFO
# SEARCH_DATES=2025-04-05,2025-04-06

# Where bot Chrome windows are placed ("x,y"). Unset = legacy positions
# (-2560,679 keep-alive / -1600,679 search), which are only off-screen on a
# single-monitor desktop. To hide the windows on a multi-monitor desktop put
# them outside the virtual desktop entirely. Keep |x|,|y| <= 20000 and avoid
# -32000 (the Windows "minimized" sentinel). Do NOT use headless or minimize —
# see CLAUDE.md "Hiding bot windows".
# BOT_WINDOW_POSITION=-20000,0

# Chrome profile (to reuse your existing browser session)
# CHROME_PROFILE_DIR=C:\Users\you\AppData\Local\Google\Chrome\User Data
# CHROME_PROFILE=Default
